{
  "version": 2,
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/api/index.js" },
    { "source": "/uploads/:path*", "destination": "/backend/api/index.js" },
    { "source": "/admin/:path*", "destination": "/backend/api/index.js" },
    { "source": "/admin", "destination": "/backend/api/index.js" }
  ]
}
